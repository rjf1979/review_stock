{
  "name": "hangqing-desktop",
  "version": "0.3.6",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "description": "股市脉搏 - A股实时行情与每日复盘桌面工具（本地取数）",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "check": "node --check storage.js && node --check storage.test.js && node --check cloud-upload.js && node --check cloud-upload.test.js && node --check review-core.js && node --check review-scheduler.js && node --check updater.js && node --check telemetry.js && node --check telemetry.test.js && node --check preload.js && node --check server.js && node --check server.test.js && node --check updater.test.js && node --check electron-main.js && node --check scripts/generate-update-manifest.js && node --check scripts/verify-package-contents.js && node scripts/check-changelog.js",
    "test": "node server.test.js && node storage.test.js && node cloud-upload.test.js && node updater.test.js && node telemetry.test.js",
    "updates:manifest": "node scripts/generate-update-manifest.js",
    "pack": "electron-builder --dir && node scripts/verify-package-contents.js",
    "dist": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && set \"ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/\" && electron-builder && node scripts/verify-package-contents.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "build": {
    "appId": "io.zhicha.dailystock",
    "productName": "股市脉搏",
    "executableName": "StockPulse",
    "electronDownload": { "mirror": "https://npmmirror.com/mirrors/electron/" },
    "asar": true,
    "compression": "maximum",
    "directories": { "output": "release" },
    "files": ["electron-main.js", "preload.js", "server.js", "storage.js", "review-core.js", "review-scheduler.js", "updater.js", "telemetry.js", "cloud-upload.js", "assets/icon.png", "frontend/**/*", "!node_modules/sql.js/**", "node_modules/sql.js/package.json", "node_modules/sql.js/dist/sql-wasm.js", "node_modules/sql.js/dist/sql-wasm.wasm", "package.json"],
    "extraResources": [{ "from": "../../LICENSE", "to": "LICENSE.txt" }],
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64", "ia32"] }],
      "artifactName": "hangqing-desktop-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "mac": { "target": ["dmg"] }
  }
}
